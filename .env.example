# Copy to .env.local and fill in. Never commit .env.local.
#
# TURN relay, only needed so the game works when a player is on mobile data.
# Two free sources:
#
#   Cloudflare  https://dash.cloudflare.com  ->  Calls  ->  TURN keys
#   Metered     https://dashboard.metered.ca  ->  free tier, 50 GB/month
#
# Multiple URLs can be comma-separated.
VITE_TURN_URL=turn:example.turn.provider:3478
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
